{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build_${hostSystemName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "base-macos",
            "hidden": true,
            "inherits": "base",
            "generator": "Unix Makefiles",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM": "/usr/bin/make"
            }
        },
        {
            "name": "base-windows",
            "hidden": true,
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "debug",
            "inherits": "base-macos",
            "displayName": "Debug - macOS (Unix Makefiles)",
            "description": "Debug build on macOS with vcpkg toolchain",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "base-macos",
            "displayName": "Release - macOS (Unix Makefiles)",
            "description": "Release build on macOS with vcpkg toolchain",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug-windows",
            "inherits": "base-windows",
            "displayName": "Debug - Windows (Visual Studio 2022)",
            "description": "Debug build on Windows with vcpkg toolchain"
        },
        {
            "name": "release-windows",
            "inherits": "base-windows",
            "displayName": "Release - Windows (Visual Studio 2022)",
            "description": "Release build on Windows with vcpkg toolchain"
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "debug-windows",
            "configurePreset": "debug-windows",
            "configuration": "Debug"
        },
        {
            "name": "release-windows",
            "configurePreset": "release-windows",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "debug-windows",
            "configurePreset": "debug-windows",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
